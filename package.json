{
  "name": "solver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "solver": "node ./dist/index.js",
    "build": "tsc",
    "dev": "tsx  ./index.ts",
    "dev-watch": "tsx --watch ./index.ts",
    "prettier:check": "prettier . --check",
    "prettier:write": "prettier . --write",
    "contracts:typegen": "typechain --node16-modules --target ethers-v5 --out-dir typechain solvers/contracts/*.json",
    "postinstall": "yarn contracts:typegen",
    "test": "vitest run",
    "pairs:init": "tsx scripts/pairs.ts init",
    "pairs:add": "tsx scripts/pairs.ts add",
    "pairs:remove": "tsx scripts/pairs.ts remove",
    "pairs:list": "tsx scripts/pairs.ts list",
    "pairs:oracle": "tsx scripts/pairs.ts oracle",
    "escrow:balance": "tsx scripts/solver-escrow/balance.ts",
    "escrow:deposit": "tsx scripts/solver-escrow/deposit.ts",
    "escrow:withdraw": "tsx scripts/solver-escrow/withdraw.ts",
    "pairs:rate": "tsx scripts/test-oracle.ts"
  },
  "devDependencies": {
    "@typechain/ethers-v5": "^11.1.2",
    "@types/copyfiles": "^2",
    "copyfiles": "^2.4.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "@hyperlane-xyz/sdk": "^8.6.1",
    "@hyperlane-xyz/utils": "^8.6.1",
    "@libsql/client": "^0.14.0",
    "chalk": "^5.3.0",
    "dotenv-flow": "^4.1.0",
    "ethers": "^5.7.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pino-socket": "^7.4.0",
    "uniqolor": "^1.1.1",
    "zod": "^3.23.8"
  }
}
